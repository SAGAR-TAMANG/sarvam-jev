{
  // Deploys browser/ to Cloudflare as a static-assets-only Worker.
  //
  // There is deliberately no "main": without a Worker script, every request is
  // served straight from the asset store. That matters here because Cloudflare
  // applies browser/_headers to static asset responses but NOT to responses
  // generated by Worker code -- and browser/_headers is what grants the page its
  // cross-origin isolation (COOP + COEP), which wllama's threads need. Adding a
  // Worker script later means setting those two headers inside it as well.
  //
  // No build step: the page is already static. Leave the build command empty and
  // let the deploy command be `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sarvam-jev",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./browser"
  }
}
