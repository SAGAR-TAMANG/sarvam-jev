{
  // Deploys this directory to Cloudflare as a static-assets-only Worker.
  //
  // It lives inside browser/ rather than at the repository root on purpose. The root
  // holds pyproject.toml, and Cloudflare's build image detects that and installs the
  // Python project -- torch and several gigabytes of CUDA wheels -- before it gets
  // anywhere near this static page. Setting the build's Root directory to "browser"
  // keeps that file out of scope entirely.
  //
  // There is deliberately no "main": without a Worker script every request is served
  // straight from the asset store, and Cloudflare applies _headers to static asset
  // responses but NOT to responses generated by Worker code. _headers is what grants
  // this page its cross-origin isolation (COOP + COEP), which wllama's threads need,
  // so adding a Worker script later means setting those two headers inside it too.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sarvam-jev",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./"
  }
}
